	<key>CFBundleName</key>
	<string>ns3fb</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<!-- Game Mode de iOS 18+: da al juego prioridad maxima de CPU y GPU y baja
	     la actividad en segundo plano. LSApplicationCategoryType por si solo NO
	     basta: Apple dice explicitamente que sin la clave de Game Mode puede no
	     activarse ("If you don't include this key in your Info.plist, Game Mode
	     might not turn on for your game"). El Metal HUD lo confirma: salia
	     "Game Mode: Off". Se declaran las dos variantes porque GCSupportsGameMode
	     es la de iOS 18.0+ (deprecada) y LSSupportsGameMode la de 18.6+. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>GCSupportsGameMode</key>
	<true/>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.3</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
