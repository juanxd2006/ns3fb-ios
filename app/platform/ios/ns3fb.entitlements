<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The guest memory map needs one contiguous ~4.5 GB reservation. Devices with
	     3 GB of RAM or less only have room for it in the extended address space.
	     A free Apple ID does not grant this entitlement; TrollStore, a jailbroken
	     install or a paid developer account with the capability enabled do. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>

	<!-- Ejecucion sostenida (iOS 17+): limita el rendimiento burst desde el
	     arranque en vez de ir al maximo y caer por throttling, que es lo que se
	     nota como "va bien un rato y luego se arrastra".
	     Descomentar SOLO si el perfil de aprovisionamiento incluye la
	     capability: con Apple ID gratis no la concede y la firma falla.
	<key>com.apple.developer.sustained-execution</key>
	<true/>
	-->

	<!-- Techo de RAM por encima del limite por proceso (iOS 15+). Solo lo concede
	     una cuenta de pago o TrollStore; con Apple ID gratis el perfil no lo
	     incluye y la firma falla, asi que queda comentado. Es la via barata
	     frente al truco de la NSExtension (docs/RAM_EXTENSION_PLAN.md).
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	-->
</dict>
</plist>
