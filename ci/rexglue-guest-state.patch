+  // --- NS3FB: trazado de resolves -----------------------------------------
+  //
+  // Cada resolve es el unico camino por el que lo escrito en la EDRAM llega a
+  // memoria del invitado (y de ahi a la pantalla). Se registra UNA LINEA POR
+  // FIRMA distinta, no una por resolve: un juego resuelve decenas de veces por
+  // frame y volcarlas todas inunda el log y pierde justo las lineas que
+  // importan. La firma agrupa origen y destino, asi que cada combinacion
+  // distinta de "que tile EDRAM se copia a donde" sale una sola vez.
+  //
+  //   w8/h8 = 0     el resolve se descarta por geometria invalida: ese pase
+  //                 nunca llega a memoria, salga lo que salga del rasterizador.
+  //   c_base        tile EDRAM de origen; se cruza con NS3FB-TGT del pase.
+  //   dst_len = 0   no hay copia (solo clear): el contenido no se escribe.
+  //   cc            RB_COPY_CONTROL: copy_src_select 0/1/2/3 = color0..3,
+  //                 4 = profundidad; copy_command 0 = kRaw, 1 = kConvert.
+  //
+  // Ademas, cada 1200 resolves se resume: NS3FB-RES-SUM con el total, cuantas
+  // firmas distintas hay y cuantos resolves se descartaron por geometria.
+  {
+    static uint64_t ns3fb_res_total = 0;
+    static uint64_t ns3fb_res_discarded = 0;
+    constexpr size_t kNs3fbResSigSlots = 96;
+    static uint32_t ns3fb_res_sig[kNs3fbResSigSlots] = {};
+    static uint64_t ns3fb_res_sig_count[kNs3fbResSigSlots] = {};
+    static size_t ns3fb_res_sig_size = 0;
+
+    ++ns3fb_res_total;
+    const uint32_t ns3fb_color_base = uint32_t(resolve_info.color_edram_info.base_tiles);
+    const uint32_t ns3fb_color_fmt = uint32_t(resolve_info.color_edram_info.format);
+    const uint32_t ns3fb_color_64bpp = uint32_t(resolve_info.color_edram_info.format_is_64bpp);
+    const uint32_t ns3fb_color_msaa = uint32_t(resolve_info.color_edram_info.msaa_samples);
+    const uint32_t ns3fb_depth_base = uint32_t(resolve_info.depth_edram_info.base_tiles);
+    const uint32_t ns3fb_w8 = uint32_t(resolve_info.coordinate_info.width_div_8);
+    const uint32_t ns3fb_h8 = uint32_t(resolve_info.height_div_8);
+    const uint32_t ns3fb_dst_base = uint32_t(resolve_info.copy_dest_base);
+    const uint32_t ns3fb_dst_start = uint32_t(resolve_info.copy_dest_extent_start);
+    const uint32_t ns3fb_dst_len = uint32_t(resolve_info.copy_dest_extent_length);
+    const uint32_t ns3fb_original = uint32_t(resolve_info.color_original_base);
+    const uint32_t ns3fb_copy_control = uint32_t(resolve_info.rb_copy_control.value);
+    if (!ns3fb_w8 || !ns3fb_h8) {
+      ++ns3fb_res_discarded;
+    }
+    const uint32_t ns3fb_sig = ns3fb_color_base * 73856093u ^ ns3fb_color_fmt * 19349663u ^
+                               ns3fb_color_64bpp * 83492791u ^ ns3fb_color_msaa * 2654435761u ^
+                               ns3fb_depth_base * 40503u ^ ns3fb_w8 * 2246822519u ^
+                               ns3fb_h8 * 3266489917u ^ ns3fb_dst_base * 668265263u ^
+                               ns3fb_dst_len * 374761393u;
+
+    bool sig_known = false;
+    for (size_t i = 0; i < ns3fb_res_sig_size; ++i) {
+      if (ns3fb_res_sig[i] == ns3fb_sig) {
+        ++ns3fb_res_sig_count[i];
+        sig_known = true;
+        break;
+      }
+    }
+    if (!sig_known && ns3fb_res_sig_size < kNs3fbResSigSlots) {
+      ns3fb_res_sig[ns3fb_res_sig_size] = ns3fb_sig;
+      ns3fb_res_sig_count[ns3fb_res_sig_size] = 1;
+      ++ns3fb_res_sig_size;
+      REXLOG_INFO(
+          "NS3FB-RES n={} c_base={} c_fmt={} c64={} c_msaa={} d_base={} w8={} h8={} "
+          "dst_base=0x{:08X} dst_start=0x{:08X} dst_len=0x{:X} orig={} cc=0x{:08X}",
+          ns3fb_res_total, ns3fb_color_base, ns3fb_color_fmt, ns3fb_color_64bpp, ns3fb_color_msaa,
+          ns3fb_depth_base, ns3fb_w8, ns3fb_h8, ns3fb_dst_base, ns3fb_dst_start, ns3fb_dst_len,
+          ns3fb_original, ns3fb_copy_control);
+    }
+    if (ns3fb_res_total % 1200 == 0) {
+      REXLOG_INFO("NS3FB-RES-SUM n={} signatures={} discarded={}", ns3fb_res_total,
+                  ns3fb_res_sig_size, ns3fb_res_discarded);
+    }
+  }
