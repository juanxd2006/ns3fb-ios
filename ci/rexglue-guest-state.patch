+// --- NS3FB: escaneo de los pixeles resueltos ------------------------------
+//
+// El resolve deja los pixeles en memoria del invitado y esa memoria se puede
+// leer desde la CPU: es lo mas parecido a una captura de GPU que se puede hacer
+// sin un Mac.
+//
+// IMPORTANTE, y es lo que se corrige aqui: Xenia acumula los comandos en un
+// command buffer diferido y los envia al final del frame. Escanear dentro de
+// Resolve() lee la memoria ANTES de que la copia se ejecute, asi que siempre
+// devolvia ceros y no valia como medida. Por eso el rango se ENCOLA en
+// Resolve() y se escanea en CompletedSubmissionUpdated(), que es el punto en el
+// que la GPU ya termino.
+//
+//   nz=0    el contenido es negro de verdad: el fallo esta en el rasterizado, en
+//           el pixel shader o en la copia del resolve.
+//   nz>0    hay pixeles con color y el fallo esta en quien muestrea esa memoria
+//           (el pase de composicion o el cache de texturas).
+namespace {
+
+constexpr size_t kNs3fbPendingRanges = 8;
+
+struct Ns3fbPendingRange {
+  uint32_t start;
+  uint32_t length;
+  uint32_t color_base;
+  uint32_t depth_base;
+  uint32_t width_div_8;
+  uint32_t height_div_8;
+};
+
+Ns3fbPendingRange g_ns3fb_pending[kNs3fbPendingRanges] = {};
+size_t g_ns3fb_pending_count = 0;
+uint64_t g_ns3fb_pending_dropped = 0;
+// Memoria del invitado, tomada del parametro de Resolve() para poder escanear
+// desde CompletedSubmissionUpdated(), que no la recibe.
+const memory::Memory* g_ns3fb_memory = nullptr;
+uint32_t g_ns3fb_mem_sig[16] = {};
+uint64_t g_ns3fb_mem_count[16] = {};
+size_t g_ns3fb_mem_sig_count = 0;
+
+void Ns3fbScanOneRange(const memory::Memory& memory, const Ns3fbPendingRange& range) {
+  const uint32_t signature = range.color_base * 73856093u ^ range.depth_base * 19349663u ^
+                             range.width_div_8 * 83492791u ^ range.height_div_8 * 2654435761u;
+  size_t slot = g_ns3fb_mem_sig_count;
+  for (size_t i = 0; i < g_ns3fb_mem_sig_count; ++i) {
+    if (g_ns3fb_mem_sig[i] == signature) {
+      slot = i;
+      break;
+    }
+  }
+  if (slot == g_ns3fb_mem_sig_count) {
+    if (g_ns3fb_mem_sig_count >= 16) {
+      return;
+    }
+    g_ns3fb_mem_sig[g_ns3fb_mem_sig_count++] = signature;
+  }
+  const uint64_t seen = ++g_ns3fb_mem_count[slot];
+  // Las dos primeras veces y luego una de cada 100: serie temporal sin inundar.
+  if (seen > 2 && seen % 100 != 0) {
+    return;
+  }
+
+  const uint8_t* base = memory.TranslatePhysical(range.start);
+  if (!base) {
+    REXLOG_INFO("NS3FB-MEM c_base={} d_base={} start=0x{:08X} len=0x{:X} unmapped=1",
+                range.color_base, range.depth_base, range.start, range.length);
+    return;
+  }
+  uint32_t step = range.length / 4096u;
+  if (step < 4u) {
+    step = 4u;
+  }
+  uint64_t pixels = 0;
+  uint64_t nonzero = 0;
+  uint64_t sum = 0;
+  uint32_t mn = 255;
+  uint32_t mx = 0;
+  uint32_t sample[4] = {0, 0, 0, 0};
+  for (uint32_t offset = 0; offset + 4u <= range.length; offset += step) {
+    const uint8_t* px_ptr = base + offset;
+    const uint32_t px = uint32_t(px_ptr[0]) | (uint32_t(px_ptr[1]) << 8) |
+                        (uint32_t(px_ptr[2]) << 16) | (uint32_t(px_ptr[3]) << 24);
+    if (px) {
+      ++nonzero;
+    }
+    sum += px_ptr[0];
+    if (px_ptr[0] < mn) {
+      mn = px_ptr[0];
+    }
+    if (px_ptr[0] > mx) {
+      mx = px_ptr[0];
+    }
+    if (pixels < 4) {
+      sample[pixels] = px;
+    }
+    ++pixels;
+  }
+  if (!pixels) {
+    return;
+  }
+  REXLOG_INFO(
+      "NS3FB-MEM n={} after=submit c_base={} d_base={} w8={} h8={} start=0x{:08X} len=0x{:X} "
+      "px={} nz={} pct={} min={} max={} mean={} s0=0x{:08X} s1=0x{:08X} s2=0x{:08X} s3=0x{:08X}",
+      seen, range.color_base, range.depth_base, range.width_div_8, range.height_div_8, range.start,
+      range.length, pixels, nonzero, uint32_t(nonzero * 100u / pixels), mn, mx,
+      uint32_t(sum / pixels), sample[0], sample[1], sample[2], sample[3]);
+}
+
+void Ns3fbScanPendingResolvedRanges() {
+  if (!g_ns3fb_memory) {
+    return;
+  }
+  const memory::Memory& memory = *g_ns3fb_memory;
+  for (size_t i = 0; i < g_ns3fb_pending_count; ++i) {
+    Ns3fbScanOneRange(memory, g_ns3fb_pending[i]);
+  }
+  g_ns3fb_pending_count = 0;
+  if (g_ns3fb_pending_dropped) {
+    REXLOG_INFO("NS3FB-MEM dropped={} (mas resolves por envio que huecos de escaneo)",
+                g_ns3fb_pending_dropped);
