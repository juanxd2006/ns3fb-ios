+// --- NS3FB: estado del invitado por pase -------------------------------
+//
+// Un mismo pase se usa para varias cosas y su estado cambia dentro del propio
+// frame: en este juego la clave 0x1C se ve con tres estados distintos
+// (contenido con blend y z test, overlay 2D con z off, y clear con cmask 0 y
+// scissor 16x16). Por eso NO se puede registrar "el estado del pase" una vez, ni
+// tampoco por revisiones: un tope de revisiones se agota en el primer segundo y
+// el resto de la sesion queda a ciegas.
+//
+// Lo que se registra es el CONJUNTO DE ESTADOS DISTINTOS de cada clave, sin
+// tope por clave (tabla plana de 128 entradas; si se llena, overflow lo dice):
+//
+//   NS3FB-STATE key=0x… sig=0x… t_ms=… at=… cmask=… bl=…/…/… z=…/…/… …
+//       Una vez por cada estado distinto. t_ms = milisegundos desde el arranque,
+//       at = numero de draw global en el que se vio por primera vez.
+//   NS3FB-TGT   key=0x… sig=0x… c0_base=… d_base=… pitch=… msaa=…
+//       Las direcciones EDRAM de ese estado, para cruzarlas con NS3FB-RES.
+//   NS3FB-SIGSTAT key=0x… sig=0x… draws=… verts=… vmin=… vmax=…
+//       Cada 1500 draws: cuantos draws y vertices lleva cada estado en ese
+//       tramo, con el minimo y el maximo de vertices por draw. ESTO es lo que
+//       permite atribuir un estado a "el mundo" (vmax de miles) o a "el HUD"
+//       (vmax de 3-4) sin adivinarlo.
+//
+// Campos de estado y que descarta cada uno:
+//
+//   cmask   mascara de escritura de color. A 0 en el RT0: el pase dibuja y no
+//           escribe nada.
+//   bl      RB_BLENDCONTROL del RT0 (factores y operacion).
+//   z       z_enable / z_write / zfunc.
+//   clip    clip_disable y dx_clip_space_def.
+//   cull    cull_front/cull_back/face.
+//   vp      viewport con signo, punto fijo x16.
+//   sci     scissor TL/BR.
+namespace {
+
+constexpr size_t kNs3fbSigSlots = 128;
+constexpr uint64_t kNs3fbSigDumpEvery = 1500;
+
+struct Ns3fbSignatureSlot {
+  uint32_t key;
+  uint32_t signature;
+  uint64_t period_draws;
+  uint64_t period_verts;
+  uint32_t period_min_verts;
+  uint32_t period_max_verts;
+};
+
+Ns3fbSignatureSlot g_ns3fb_sig_slots[kNs3fbSigSlots] = {};
+size_t g_ns3fb_sig_slot_count = 0;
+uint64_t g_ns3fb_sig_overflow = 0;
+uint64_t g_ns3fb_sig_period_draws = 0;
+uint64_t g_ns3fb_sig_total_draws = 0;
+
+}  // namespace
+
+// Milisegundos desde la primera llamada: da una hora relativa de sesion para
+// cada estado, independiente de los timestamps del logger.
+static uint64_t Ns3fbNowMs() {
+  static const auto start = std::chrono::steady_clock::now();
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+static void Ns3fbDumpSignatureStats() {
+  for (size_t i = 0; i < g_ns3fb_sig_slot_count; ++i) {
+    Ns3fbSignatureSlot& slot = g_ns3fb_sig_slots[i];
+    if (!slot.period_draws) {
+      continue;
+    }
+    REXLOG_INFO("NS3FB-SIGSTAT key=0x{:08X} sig=0x{:08X} draws={} verts={} vmin={} vmax={}",
+                slot.key, slot.signature, slot.period_draws, slot.period_verts,
+                slot.period_min_verts, slot.period_max_verts);
+    slot.period_draws = 0;
+    slot.period_verts = 0;
+    slot.period_min_verts = 0;
+    slot.period_max_verts = 0;
+  }
+  if (g_ns3fb_sig_overflow) {
+    REXLOG_INFO("NS3FB-SIGSTAT overflow={} (estados distintos sin hueco en la tabla)",
+                g_ns3fb_sig_overflow);
+    g_ns3fb_sig_overflow = 0;
+  }
+}
+
+static void Ns3fbNoteGuestState(const VulkanRenderTargetCache::RenderPassKey& key,
+                                const RegisterFile& regs, uint32_t index_count, bool indexed) {
+  const auto color_mask = regs.Get<reg::RB_COLOR_MASK>();
+  const auto blend_0 = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[0]);
+  const auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  const auto clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  const auto sc_mode = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  const auto scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  const auto scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto color_0_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]);
+  const auto color_1_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[1]);
+  const auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+
+  // Todo a enteros: los campos son bit-fields y fmt no los puede enlazar por
+  // referencia; los floats de viewport se pasan a punto fijo x16.
+  const uint32_t cmask = uint32_t(color_mask.value) & 0xFFFFu;
+  const uint32_t bl_src = uint32_t(blend_0.color_srcblend);
+  const uint32_t bl_op = uint32_t(blend_0.color_comb_fcn);
+  const uint32_t bl_dst = uint32_t(blend_0.color_destblend);
+  const uint32_t z_en = uint32_t(depth_control.z_enable);
+  const uint32_t z_wr = uint32_t(depth_control.z_write_enable);
+  const uint32_t zfunc = uint32_t(depth_control.zfunc);
+  const uint32_t clip_dis = uint32_t(clip_cntl.clip_disable);
+  const uint32_t dxclip = uint32_t(clip_cntl.dx_clip_space_def);
+  const uint32_t cull_f = uint32_t(sc_mode.cull_front);
+  const uint32_t cull_b = uint32_t(sc_mode.cull_back);
+  const uint32_t face = uint32_t(sc_mode.face);
+  const int32_t vp_xs = int32_t(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) * 16.0f);
+  const int32_t vp_xo = int32_t(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) * 16.0f);
+  const int32_t vp_ys = int32_t(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) * 16.0f);
+  const int32_t vp_yo = int32_t(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) * 16.0f);
+  const uint32_t sci_tl_x = uint32_t(scissor_tl.tl_x);
+  const uint32_t sci_tl_y = uint32_t(scissor_tl.tl_y);
+  const uint32_t sci_br_x = uint32_t(scissor_br.br_x);
+  const uint32_t sci_br_y = uint32_t(scissor_br.br_y);
+  const uint32_t c0_base =
+      uint32_t(color_0_info.color_base) | (uint32_t(color_0_info.color_base_bit_11) << 11);
+  const uint32_t c1_base =
+      uint32_t(color_1_info.color_base) | (uint32_t(color_1_info.color_base_bit_11) << 11);
+  const uint32_t d_base =
+      uint32_t(depth_info.depth_base) | (uint32_t(depth_info.depth_base_bit_11) << 11);
+  const uint32_t c0_fmt = uint32_t(color_0_info.color_format);
+  const uint32_t c1_fmt = uint32_t(color_1_info.color_format);
+  const uint32_t d_fmt = uint32_t(depth_info.depth_format);
+  const uint32_t pitch = uint32_t(surface_info.surface_pitch);
+  const uint32_t msaa = uint32_t(surface_info.msaa_samples);
+
+  uint32_t signature = key.key;
+  signature = signature * 16777619u ^ cmask;
+  signature = signature * 16777619u ^ (bl_src | (bl_op << 8) | (bl_dst << 16));
+  signature = signature * 16777619u ^ (z_en | (z_wr << 1) | (zfunc << 2));
+  signature = signature * 16777619u ^
+              (clip_dis | (dxclip << 1) | (cull_f << 2) | (cull_b << 3) | (face << 4));
+  signature = signature * 16777619u ^ uint32_t(vp_xs) ^ (uint32_t(vp_xo) << 13) ^
+              (uint32_t(vp_ys) << 7) ^ (uint32_t(vp_yo) << 21);
+  signature = signature * 16777619u ^
+              (sci_tl_x | (sci_tl_y << 14) | (sci_br_x << 5) | (sci_br_y << 19));
+  signature = signature * 16777619u ^
+              (c0_base | (c0_fmt << 12) | (c1_base << 16) | (c1_fmt << 28));
+  signature = signature * 16777619u ^
+              (d_base | (d_fmt << 12) | (pitch << 16) | (msaa << 27));
+
+  Ns3fbSignatureSlot* slot = nullptr;
+  for (size_t i = 0; i < g_ns3fb_sig_slot_count; ++i) {
+    if (g_ns3fb_sig_slots[i].key == key.key &&
+        g_ns3fb_sig_slots[i].signature == signature) {
+      slot = &g_ns3fb_sig_slots[i];
+      break;
+    }
+  }
+  if (!slot) {
+    if (g_ns3fb_sig_slot_count >= kNs3fbSigSlots) {
+      ++g_ns3fb_sig_overflow;
+    } else {
+      slot = &g_ns3fb_sig_slots[g_ns3fb_sig_slot_count++];
+      slot->key = key.key;
+      slot->signature = signature;
+      slot->period_draws = 0;
+      slot->period_verts = 0;
+      slot->period_min_verts = 0;
+      slot->period_max_verts = 0;
+      // Primera vez que se ve este estado: se describe una sola vez.
+      REXLOG_INFO(
+          "NS3FB-STATE key=0x{:08X} sig=0x{:08X} t_ms={} at={} cmask=0x{:04X} bl={}/{}/{} "
+          "z={}/{}/{} clip_dis={} dxclip={} cull_f={} cull_b={} face={} vp={},{},{},{} "
+          "sci={},{} {},{}",
+          key.key, signature, Ns3fbNowMs(), g_ns3fb_sig_total_draws, cmask, bl_src, bl_op, bl_dst,
+          z_en, z_wr, zfunc, clip_dis, dxclip, cull_f, cull_b, face, vp_xs, vp_xo, vp_ys, vp_yo,
+          sci_tl_x, sci_tl_y, sci_br_x, sci_br_y);
+      REXLOG_INFO(
+          "NS3FB-TGT key=0x{:08X} sig=0x{:08X} c0_base={} c0_fmt={} c1_base={} c1_fmt={} "
+          "d_base={} d_fmt={} pitch={} msaa={}",
+          key.key, signature, c0_base, c0_fmt, c1_base, c1_fmt, d_base, d_fmt, pitch, msaa);
+    }
+  }
+  if (slot) {
+    ++slot->period_draws;
+    slot->period_verts += index_count;
+    if (!slot->period_min_verts || index_count < slot->period_min_verts) {
+      slot->period_min_verts = index_count;
+    }
+    if (index_count > slot->period_max_verts) {
+      slot->period_max_verts = index_count;
+    }
+  }
+  (void)indexed;
+
+  ++g_ns3fb_sig_total_draws;
+  if (++g_ns3fb_sig_period_draws >= kNs3fbSigDumpEvery) {
+    g_ns3fb_sig_period_draws = 0;
+    Ns3fbDumpSignatureStats();
+  }
+}
