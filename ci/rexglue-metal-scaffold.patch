diff --git a/include/rex/graphics/metal/graphics_system.h b/include/rex/graphics/metal/graphics_system.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/metal/graphics_system.h
@@ -0,0 +1,43 @@
+#pragma once
+/**
+ * ReXGlue: backend Metal nativo (en construccion).
+ *
+ * ESQUELETO. Existe para dos cosas:
+ *   1. validar que el plugin compila, se carga y es seleccionable con
+ *      gpu_plugin = "xenos" + backend = "metal" (REXGLUE_USE_METAL=ON);
+ *   2. fijar la forma que tendra el backend real, igual que el de Vulkan.
+ *
+ * Lo que falta, por orden (ver docs/METAL_PORT_PLAN.md):
+ *   - MetalProvider / MetalPresenter  (ui::GraphicsProvider / ui::Presenter)
+ *   - MetalCommandProcessor           (PM4 + estado)
+ *   - MetalTextureCache / MetalRenderTargetCache / MetalPipelineCache
+ *
+ * Referencia con la que se cuenta: src/xenia/gpu/metal/ de XeniOS y
+ * Xenia-Edge (33.092 lineas, BSD-3).
+ */
+
+#include <memory>
+#include <string>
+
+#include <rex/graphics/graphics_system.h>
+
+namespace rex::graphics::metal {
+
+class MetalGraphicsSystem : public GraphicsSystem {
+ public:
+  MetalGraphicsSystem();
+  ~MetalGraphicsSystem() override;
+
+  /// true solo si el plugin compila con backend Metal. NO implica que el
+  /// backend este implementado: hoy devuelve false para que `backend = "any"`
+  /// no lo elija por accidente.
+  static bool IsAvailable();
+
+  std::string name() const override;
+
+ protected:
+  void CreateProvider(bool with_presentation) override;
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/graphics_system.mm b/src/graphics/metal/graphics_system.mm
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/graphics_system.mm
@@ -0,0 +1,60 @@
+/**
+ * ReXGlue: backend Metal nativo (en construccion) — esqueleto.
+ *
+ * Este fichero hace, de momento, tres cosas y solo tres:
+ *   - crear el MTLDevice y decir en el log cual es (valida que el plugin tiene
+ *     acceso a Metal desde dentro de la dylib en iOS);
+ *   - devolver un nombre;
+ *   - dejar constancia de lo que falta.
+ *
+ * Objetivo del primer build: que la cadena CMake -> plugin -> fabrica ->
+ * IGraphicsSystem funcione y se lea el nombre de la GPU en el log. Nada mas.
+ * La emulacion (command processor, caches) va despues y por partes:
+ * ver docs/METAL_PORT_PLAN.md.
+ */
+
+#include <rex/graphics/metal/graphics_system.h>
+
+#include <rex/logging.h>
+
+#if defined(__APPLE__)
+#import <Metal/Metal.h>
+#endif
+
+namespace rex::graphics::metal {
+
+MetalGraphicsSystem::MetalGraphicsSystem() {
+#if defined(__APPLE__)
+  id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+  if (device) {
+    REXLOG_INFO("metal: dispositivo '{}' ({} GB de memoria recomendada)",
+                device.name.UTF8String, device.recommendedMaxWorkingSetSize >> 30);
+  } else {
+    REXLOG_ERROR("metal: MTLCreateSystemDefaultDevice devolvio null");
+  }
+#else
+  REXLOG_WARN("metal: backend compilado fuera de Apple; solo se puede enlazar");
+#endif
+}
+
+MetalGraphicsSystem::~MetalGraphicsSystem() = default;
+
+bool MetalGraphicsSystem::IsAvailable() {
+  // A proposito: el esqueleto no implementa provider ni command processor, asi
+  // que no debe poder seleccionarse con backend = "any".
+  return false;
+}
+
+std::string MetalGraphicsSystem::name() const { return "Metal"; }
+
+void MetalGraphicsSystem::CreateProvider(bool with_presentation) {
+  (void)with_presentation;
+  REXLOG_ERROR("metal: CreateProvider sin implementar (falta MetalProvider/Presenter)");
+}
+
+std::unique_ptr<CommandProcessor> MetalGraphicsSystem::CreateCommandProcessor() {
+  REXLOG_ERROR("metal: CreateCommandProcessor sin implementar (falta MetalCommandProcessor)");
+  return nullptr;
+}
+
+}  // namespace rex::graphics::metal
