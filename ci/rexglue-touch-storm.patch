+// Fighting-game layout, normalized to the overlay (landscape).
+// Modelled on the official STORM mobile arrangement: big move stick bottom-left,
+// attack diamond on the right with the primary button largest, support characters
+// stacked on the right edge, item slots along the bottom, camera limited to a band
+// so a stray swipe no longer steals the whole screen.
+constexpr float kRefWidth = 844.0f;   // iPhone landscape reference, for circle sizing
+constexpr float kRefHeight = 390.0f;
+
+// Frame for a control of `pixels` diameter, centred at (cx, cy) in normalized space.
+constexpr TouchRect CenteredFrame(float cx, float cy, float pixels) {
+  const float w = pixels / kRefWidth;
+  const float h = pixels / kRefHeight;
+  return {cx - w * 0.5f, cy - h * 0.5f, w, h};
+}
