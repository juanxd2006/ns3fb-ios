+// --- NS3FB: contadores de draw calls -------------------------------------
+//
+// Sirve para responder a una sola pregunta con un build: el juego manda
+// dibujar el mundo 3D en la pelea, o no?
+//
+//   - si en la pelea se acumulan draws con primitivas de triangulos e indices,
+//     el mundo SI se envia y el fallo esta en el estado/binding del emulador;
+//   - si en la pelea solo aparecen quads y lineas (efectos y HUD), el juego no
+//     esta emitiendo la geometria del mundo, y el fallo es de logica del
+//     invitado (culling/LOD) o de datos, no del renderer.
+//
+// Se imprime una linea cada 300 draws, con el reparto por tipo de primitiva.
+namespace {
+
+std::atomic<uint64_t> g_ns3fb_draw_total{0};
+std::atomic<uint64_t> g_ns3fb_draw_indexed{0};
+std::atomic<uint64_t> g_ns3fb_verts_total{0};
+std::atomic<uint64_t> g_ns3fb_draw_by_prim[32] = {};
+
+}  // namespace
+
+static void Ns3fbLogDrawStatsIfNeeded() {
+  static uint64_t last_logged_total = 0;
+  const uint64_t total = g_ns3fb_draw_total.load(std::memory_order_relaxed);
+  if (total - last_logged_total < 300) {
+    return;
+  }
+  last_logged_total = total;
+  const uint64_t indexed = g_ns3fb_draw_indexed.exchange(0, std::memory_order_relaxed);
+  const uint64_t verts = g_ns3fb_verts_total.exchange(0, std::memory_order_relaxed);
+  std::string prims;
+  for (uint32_t i = 0; i < 32; ++i) {
+    const uint64_t count = g_ns3fb_draw_by_prim[i].exchange(0, std::memory_order_relaxed);
+    if (count) {
+      prims += " p";
+      prims += std::to_string(i);
+      prims += "=";
+      prims += std::to_string(count);
+    }
+  }
+  REXLOG_INFO("NS3FB-DRAW next300 indexed={} verts={} prims:{}", indexed, verts, prims);
+}
