diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
index d54df86..6a63b54 100644
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -52,6 +52,17 @@ class IGraphicsSystem {
 
   // --- Optional capabilities, default no-op -------------------------------
 
+  // Stop / restart guest GPU work.
+  //
+  // En iOS el proceso pierde el permiso de enviar trabajo a la GPU en cuanto
+  // pasa a segundo plano: el primer vkQueueSubmit despues devuelve
+  // VK_ERROR_DEVICE_LOST (kIOGPUCommandBufferCallbackErrorBackgroundExecution
+  // NotPermitted) y MoltenVK no se recupera, asi que la imagen se queda negra
+  // para siempre. Parar el command processor al perder el foco evita llegar a
+  // ese submit. Los backends que no lo necesiten lo dejan como no-op.
+  virtual void Pause() {}
+  virtual void Resume() {}
+
   // Host presentation objects for ReXApp's overlay wiring; custom systems may
   // leave these null.
   virtual ui::GraphicsProvider* provider() const { return nullptr; }
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 8f2fcb0..4cd60b7 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -365,11 +365,25 @@ void GraphicsSystem::InitializeShaderStorage(const std::filesystem::path& cache_
 }
 
 void GraphicsSystem::Pause() {
+  // El command processor se crea en SetupGuestGpu(), que ocurre DESPUES de
+  // SetupPresentation(). En iOS el evento de perder el foco puede llegar
+  // durante el arranque, con command_processor_ todavia a null: sin esta
+  // guarda, Pause() desreferencia null y la app crashea al abrir.
+  // Si aun no existe no hay nada que parar: el invitado no ha empezado.
+  if (!command_processor_) {
+    return;
+  }
+  if (paused_) {
+    return;
+  }
   paused_ = true;
   command_processor_->Pause();
 }
 
 void GraphicsSystem::Resume() {
+  if (!command_processor_ || !paused_) {
+    return;
+  }
   paused_ = false;
   command_processor_->Resume();
 }
diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
index b94fe9e..27449b2 100644
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -13,6 +13,12 @@
 
 #include <cstdlib>
 
+#if defined(__APPLE__)
+// TARGET_OS_IPHONE: hace falta para distinguir iOS de macOS en las rutas de
+// pausa de la GPU. No lo arrastra ninguna cabecera de forma fiable.
+#include <TargetConditionals.h>
+#endif
+
 #include <rex/assert.h>
 #include <rex/cvar.h>
 #include <rex/ui/flags.h>
@@ -535,11 +541,25 @@ void ReXApp::OnDpiChanged(ui::UISetupEvent& e) {
 
 void ReXApp::OnGotFocus(ui::UISetupEvent& e) {
   (void)e;
+#if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
+  // Reanudar el command processor antes de que el invitado vuelva a dibujar.
+  if (config_.graphics) {
+    config_.graphics->Resume();
+  }
+#endif
   OnWindowFocusChanged(true);
 }
 
 void ReXApp::OnLostFocus(ui::UISetupEvent& e) {
   (void)e;
+#if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
+  // iOS revoca el permiso de enviar trabajo a la GPU en cuanto la app deja de
+  // estar en primer plano. Si el invitado llega a hacer un submit despues, el
+  // VkDevice se pierde y no se recupera: pantalla negra permanente.
+  if (config_.graphics) {
+    config_.graphics->Pause();
+  }
+#endif
   OnWindowFocusChanged(false);
 }
 
