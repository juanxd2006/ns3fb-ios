--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -52,6 +52,17 @@ class IGraphicsSystem {
 
   // --- Optional capabilities, default no-op -------------------------------
 
+  // Stop / restart guest GPU work.
+  //
+  // En iOS el proceso pierde el permiso de enviar trabajo a la GPU en cuanto
+  // pasa a segundo plano: el primer vkQueueSubmit despues devuelve
+  // VK_ERROR_DEVICE_LOST (kIOGPUCommandBufferCallbackErrorBackgroundExecution
+  // NotPermitted) y MoltenVK no se recupera, asi que la imagen se queda negra
+  // para siempre. Parar el command processor al perder el foco evita llegar a
+  // ese submit. Los backends que no lo necesiten lo dejan como no-op.
+  virtual void Pause() {}
+  virtual void Resume() {}
+
   // Host presentation objects for ReXApp's overlay wiring; custom systems may
   // leave these null.
   virtual ui::GraphicsProvider* provider() const { return nullptr; }
diff --git a/include/rex/ui/presenter.h b/include/rex/ui/presenter.h
index afb4a30..bfd9692 100644
--- a/include/rex/ui/presenter.h
+++ b/include/rex/ui/presenter.h
@@ -374,6 +374,17 @@ class Presenter {
   // Requests (re)painting with the UI if there's UI to draw.
   void RequestUIPaintFromUIThread();
 
+  // NS3FB iOS: al pasar a segundo plano iOS revoca el permiso de enviar trabajo
+  // a la GPU, y el primer submit posterior pierde el VkDevice para siempre
+  // (kIOGPUCommandBufferCallbackErrorBackgroundExecutionNotPermitted). Parar el
+  // invitado no basta: el presentador sigue adquiriendo imagenes del swapchain,
+  // y esa es la otra ruta que mata el dispositivo. Mientras esto esta activo,
+  // PaintAndPresent sale sin tocar la GPU; al volver a primer plano se desactiva
+  // y el siguiente paint presenta con normalidad.
+  void SetPresentationSuspended(bool suspended) {
+    presentation_suspended_.store(suspended, std::memory_order_relaxed);
+  }
+
  protected:
   enum class PaintResult {
     kPresented,
@@ -992,6 +1003,8 @@ class Presenter {
   // deferred and be handled by the tail of PaintFromUIThread for consistency
   // with what PaintFromUIThread does internally.
   bool is_in_ui_thread_paint_ = false;
+  // NS3FB iOS: ver SetPresentationSuspended.
+  std::atomic<bool> presentation_suspended_{false};
   bool request_guest_output_paint_after_current_ui_thread_paint_;
   bool request_ui_paint_after_current_ui_thread_paint_;
 
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 6c59ba6..16af8f0 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -385,11 +385,25 @@ void GraphicsSystem::InitializeShaderStorage(const std::filesystem::path& cache_
 }
 
 void GraphicsSystem::Pause() {
+  // El command processor se crea en SetupGuestGpu(), que ocurre DESPUES de
+  // SetupPresentation(). En iOS el evento de perder el foco puede llegar
+  // durante el arranque, con command_processor_ todavia a null: sin esta
+  // guarda, Pause() desreferencia null y la app crashea al abrir.
+  // Si aun no existe no hay nada que parar: el invitado no ha empezado.
+  if (!command_processor_) {
+    return;
+  }
+  if (paused_) {
+    return;
+  }
   paused_ = true;
   command_processor_->Pause();
 }
 
 void GraphicsSystem::Resume() {
+  if (!command_processor_ || !paused_) {
+    return;
+  }
   paused_ = false;
   command_processor_->Resume();
 }
diff --git a/src/ui/presenter.cpp b/src/ui/presenter.cpp
index 7360ed9..978835a 100644
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -1495,6 +1495,12 @@ bool Presenter::InSurfaceOnMonitorFromUIThread() const {
 }
 
 Presenter::PaintResult Presenter::PaintAndPresent(bool execute_ui_drawers) {
+  // NS3FB iOS: con la app en segundo plano no se puede tocar la GPU (ver
+  // Presenter::SetPresentationSuspended). Se sale antes de cualquier submit o
+  // de cualquier vkAcquireNextImageKHR.
+  if (presentation_suspended_.load(std::memory_order_relaxed)) {
+    return PaintResult::kNotPresented;
+  }
   assert_false(execute_ui_drawers && !is_in_ui_thread_paint_);
   assert_true(surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable);
   PaintResult result = PaintAndPresentImpl(execute_ui_drawers);
