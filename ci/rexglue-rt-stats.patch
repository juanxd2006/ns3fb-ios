+// --- NS3FB: reparto de draws por tipo de render pass ----------------------
+//
+// Responde a "a que pase van los draws del mundo": agrupa los draws en
+// ventanas de 300 y las vuelca con el key del pase en el que cae cada uno.
+//
+// Combinado con NS3FB-DRAW (vertices por ventana) se ve si los draws de 66.000
+// vertices van a un pase con depth y formato 8:8:8:8, o al de
+// 16_16_16_16_FLOAT sin depth. Los keys se imprimen en DECIMAL; para pasarlos
+// a hexadecimal: 6=0x6, 14=0xE, 1802=0x70A, 1800=0x708.
+//
+// Todo va como enteros: los campos del key son bit-fields y fmt no los puede
+// enlazar por referencia; y no se construyen cadenas para no depender de que
+// fmt::format este disponible en esta unidad.
+namespace {
+
+uint32_t g_ns3fb_win_keys[4] = {};
+uint64_t g_ns3fb_win_counts[4] = {};
+size_t g_ns3fb_win_size = 0;
+uint64_t g_ns3fb_win_total = 0;
+
+}  // namespace
+
+static void Ns3fbNoteRenderPassKey(const VulkanRenderTargetCache::RenderPassKey& key) {
+  // Registrar el tipo de pase la primera vez que se ve, con sus formatos.
+  static uint32_t ns3fb_seen_keys[24];
+  static size_t ns3fb_seen_count = 0;
+  bool known = false;
+  for (size_t i = 0; i < ns3fb_seen_count; ++i) {
+    if (ns3fb_seen_keys[i] == key.key) {
+      known = true;
+      break;
+    }
+  }
+  if (!known && ns3fb_seen_count < 24) {
+    ns3fb_seen_keys[ns3fb_seen_count++] = key.key;
+    const uint32_t msaa_samples = uint32_t(key.msaa_samples);
+    const uint32_t depth_used = key.depth_and_color_used & 1u;
+    const uint32_t color_used = key.depth_and_color_used >> 1;
+    const uint32_t depth_format = uint32_t(key.depth_format);
+    const uint32_t color_0 = uint32_t(key.color_0_view_format);
+    const uint32_t color_1 = uint32_t(key.color_1_view_format);
+    const uint32_t color_2 = uint32_t(key.color_2_view_format);
+    const uint32_t color_3 = uint32_t(key.color_3_view_format);
+    const uint32_t use_transfer = uint32_t(key.color_rts_use_transfer_formats);
+    REXLOG_INFO(
+        "NS3FB-RT key=0x{:08X} msaa={} depth_used={} color_used=0x{:X} depth_fmt={} "
+        "color_fmt={},{},{},{} xfer={}",
+        key.key, msaa_samples, depth_used, color_used, depth_format, color_0, color_1, color_2,
+        color_3, use_transfer);
+  }
+
+  // Ventana de 300 draws: cuantos caen en cada tipo de pase.
+  bool slot_found = false;
+  for (size_t i = 0; i < g_ns3fb_win_size; ++i) {
+    if (g_ns3fb_win_keys[i] == key.key) {
+      ++g_ns3fb_win_counts[i];
+      slot_found = true;
+      break;
+    }
+  }
+  if (!slot_found && g_ns3fb_win_size < 4) {
+    g_ns3fb_win_keys[g_ns3fb_win_size] = key.key;
+    g_ns3fb_win_counts[g_ns3fb_win_size] = 1;
+    ++g_ns3fb_win_size;
+  }
+  ++g_ns3fb_win_total;
+
+  if (g_ns3fb_win_total >= 300) {
+    REXLOG_INFO("NS3FB-KEYS n={} k0={} c0={} k1={} c1={} k2={} c2={} k3={} c3={}",
+                g_ns3fb_win_total, g_ns3fb_win_keys[0], g_ns3fb_win_counts[0], g_ns3fb_win_keys[1],
+                g_ns3fb_win_counts[1], g_ns3fb_win_keys[2], g_ns3fb_win_counts[2],
+                g_ns3fb_win_keys[3], g_ns3fb_win_counts[3]);
+    g_ns3fb_win_size = 0;
+    g_ns3fb_win_total = 0;
+    for (size_t i = 0; i < 4; ++i) {
+      g_ns3fb_win_keys[i] = 0;
+      g_ns3fb_win_counts[i] = 0;
+    }
+  }
+}
