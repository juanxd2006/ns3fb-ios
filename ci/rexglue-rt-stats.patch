+// --- NS3FB: tipos de render pass en uso -----------------------------------
+//
+// Registra cada combinacion distinta de formatos de color/depth que el juego
+// usa, con cuantos adjuntos y con que MSAA. Responde, sin captura de GPU, a la
+// pregunta "a que formato va el mundo 3D y con que depth".
+//
+// Los formatos son los enums del invitado (xenos::ColorRenderTargetFormat y
+// xenos::DepthRenderTargetFormat), que es lo que hace falta para cruzarlos con
+// lo que MoltenVK dice soportar en el log.
+static void Ns3fbLogRenderPassKey(const VulkanRenderTargetCache::RenderPassKey& key) {
+  static uint32_t ns3fb_seen_keys[24];
+  static size_t ns3fb_seen_count = 0;
+  for (size_t i = 0; i < ns3fb_seen_count; ++i) {
+    if (ns3fb_seen_keys[i] == key.key) {
+      return;
+    }
+  }
+  if (ns3fb_seen_count >= 24) {
+    return;
+  }
+  ns3fb_seen_keys[ns3fb_seen_count++] = key.key;
+  REXLOG_INFO(
+      "NS3FB-RT key=0x{:08X} msaa={} depth_used={} color_used=0x{:X} depth_fmt={} "
+      "color_fmt={},{},{},{} xfer={}",
+      key.key, uint32_t(key.msaa_samples), key.depth_and_color_used & 1u,
+      key.depth_and_color_used >> 1, uint32_t(key.depth_format),
+      uint32_t(key.color_0_view_format), uint32_t(key.color_1_view_format),
+      uint32_t(key.color_2_view_format), uint32_t(key.color_3_view_format),
+      key.color_rts_use_transfer_formats);
+}
