+// --- NS3FB: reparto de draws por tipo de render pass ----------------------
+//
+// Responde a "a que pase van los draws del mundo, y cuantos vertices lleva
+// cada uno". Tabla ACUMULATIVA por clave, volcada cada 1500 draws clasificados:
+//
+//   Por que acumulativa y no por ventana de 300: en pelea hay del orden de
+//   miles de draws por segundo, asi que una ventana de 300 volcada entera
+//   (cabecera + una linea por clave) inunda el log y en el iPhone se pierden
+//   lineas. Acumulando, el volcado cabe holgadamente y la pregunta "donde
+//   caen los ~66.000 vertices del mundo" se responde en UNA linea.
+//
+//   NS3FB-KEYS    cabecera: total clasificado, tamano de la tabla, claves que
+//                 no cupieron (dropped) y draws que el contador global vio
+//                 pero que nunca llegaron a los render targets (lost_cum) con
+//                 el detalle del ultimo periodo (lost). Si lost_cum != 0 hay
+//                 draws que mueren en IssueDraw antes de tocar el pase.
+//   NS3FB-KEYSK   una linea por clave, con dibujos, vertices e indexados.
+//   NS3FB-RT      una vez por tipo de pase visto, con sus formatos.
+//
+// 16 claves: el log reporta 9 tipos de pase en uso, asi que con 4 (version
+// anterior) los draws de la 5a en adelante se perdian en silencio.
+//
+// Todo va como enteros: los campos del key son bit-fields y fmt no los puede
+// enlazar por referencia; y no se construyen cadenas para no depender de que
+// fmt::format este disponible en esta unidad.
+namespace {
+
+constexpr size_t kNs3fbKeySlots = 16;
+constexpr uint64_t kNs3fbKeysDumpEvery = 1500;
+uint32_t g_ns3fb_win_keys[kNs3fbKeySlots] = {};
+uint64_t g_ns3fb_win_draws[kNs3fbKeySlots] = {};
+uint64_t g_ns3fb_win_verts[kNs3fbKeySlots] = {};
+uint64_t g_ns3fb_win_indexed[kNs3fbKeySlots] = {};
+size_t g_ns3fb_win_size = 0;
+uint64_t g_ns3fb_win_total = 0;
+uint64_t g_ns3fb_win_dropped = 0;
+uint64_t g_ns3fb_keys_last_seen_total = 0;
+
+}  // namespace
+
+static void Ns3fbDumpRenderPassKeyTable() {
+  const uint64_t seen_total = g_ns3fb_draw_total.load(std::memory_order_relaxed);
+  const uint64_t lost_cum = seen_total - g_ns3fb_win_total;
+  const uint64_t lost = seen_total - g_ns3fb_keys_last_seen_total - kNs3fbKeysDumpEvery;
+  g_ns3fb_keys_last_seen_total = seen_total;
+
+  REXLOG_INFO("NS3FB-KEYS n={} slots={} dropped={} lost={} lost_cum={}", g_ns3fb_win_total,
+              g_ns3fb_win_size, g_ns3fb_win_dropped, lost, lost_cum);
+  for (size_t i = 0; i < g_ns3fb_win_size; ++i) {
+    const uint32_t key = g_ns3fb_win_keys[i];
+    REXLOG_INFO("NS3FB-KEYSK slot={} key={} hex=0x{:X} draws={} verts={} indexed={}", i, key, key,
+                g_ns3fb_win_draws[i], g_ns3fb_win_verts[i], g_ns3fb_win_indexed[i]);
+  }
+}
+
+static void Ns3fbNoteRenderPassKey(const VulkanRenderTargetCache::RenderPassKey& key,
+                                   uint32_t index_count, bool indexed) {
+  // Registrar el tipo de pase la primera vez que se ve, con sus formatos.
+  static uint32_t ns3fb_seen_keys[24];
+  static size_t ns3fb_seen_count = 0;
+  bool known = false;
+  for (size_t i = 0; i < ns3fb_seen_count; ++i) {
+    if (ns3fb_seen_keys[i] == key.key) {
+      known = true;
+      break;
+    }
+  }
+  if (!known && ns3fb_seen_count < 24) {
+    ns3fb_seen_keys[ns3fb_seen_count++] = key.key;
+    const uint32_t msaa_samples = uint32_t(key.msaa_samples);
+    const uint32_t depth_used = uint32_t(key.depth_and_color_used & 1u);
+    const uint32_t color_used = uint32_t(key.depth_and_color_used) >> 1;
+    const uint32_t depth_format = uint32_t(key.depth_format);
+    const uint32_t color_0 = uint32_t(key.color_0_view_format);
+    const uint32_t color_1 = uint32_t(key.color_1_view_format);
+    const uint32_t color_2 = uint32_t(key.color_2_view_format);
+    const uint32_t color_3 = uint32_t(key.color_3_view_format);
+    const uint32_t use_transfer = uint32_t(key.color_rts_use_transfer_formats);
+    REXLOG_INFO(
+        "NS3FB-RT key=0x{:08X} msaa={} depth_used={} color_used=0x{:X} depth_fmt={} "
+        "color_fmt={},{},{},{} xfer={}",
+        key.key, msaa_samples, depth_used, color_used, depth_format, color_0, color_1, color_2,
+        color_3, use_transfer);
+  }
+
+  // Tabla acumulativa por clave.
+  size_t slot = g_ns3fb_win_size;
+  for (size_t i = 0; i < g_ns3fb_win_size; ++i) {
+    if (g_ns3fb_win_keys[i] == key.key) {
+      slot = i;
+      break;
+    }
+  }
+  if (slot == g_ns3fb_win_size) {
+    if (g_ns3fb_win_size >= kNs3fbKeySlots) {
+      // Mas tipos de pase que huecos: se contabiliza como no clasificado en
+      // lugar de perderlo en silencio (dropped > 0 en la cabecera lo delata).
+      ++g_ns3fb_win_dropped;
+      ++g_ns3fb_win_total;
+      if (g_ns3fb_win_total % kNs3fbKeysDumpEvery == 0) {
+        Ns3fbDumpRenderPassKeyTable();
+      }
+      return;
+    }
+    g_ns3fb_win_keys[g_ns3fb_win_size] = key.key;
+    ++g_ns3fb_win_size;
+  }
+  ++g_ns3fb_win_draws[slot];
+  g_ns3fb_win_verts[slot] += index_count;
+  if (indexed) {
+    ++g_ns3fb_win_indexed[slot];
+  }
+  ++g_ns3fb_win_total;
+
+  if (g_ns3fb_win_total % kNs3fbKeysDumpEvery == 0) {
+    Ns3fbDumpRenderPassKeyTable();
+  }
+}
