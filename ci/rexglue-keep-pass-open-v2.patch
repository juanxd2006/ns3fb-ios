+std::atomic<uint64_t> g_pass_split_by_attachment{0};
+
+// NS3FB: en las GPU Apple (TBDR) cada ruptura del render pass obliga a volcar
+// los tiles a memoria y recargarlos al abrirlo de nuevo. Storm 3 rompe el pase
+// ~130 veces por frame, y eso solo ya cuesta ~30 ms de GPU incluso con la
+// pantalla en negro (medido con el overlay de MoltenVK: 30.18 ms GPU, 26 ms de
+// ellos fijos, sin geometria alguna).
+//
+// Mantener el pase abierto es legal en Vulkan siempre que las barreras no
+// transicionen un adjunto del pase activo: cambiar el layout de un attachment
+// a mitad de pase es comportamiento indefinido. Las barreras que llevan una
+// textura muestreada a SHADER_READ_ONLY / TRANSFER / GENERAL si son legales
+// dentro del pase y no deben romperlo.
+//
+// Se activa creando Documents/keep_pass_open.txt en la app Archivos; sin ese
+// archivo el comportamiento es exactamente el de antes.
+bool KeepPassOpenEnabled() {
+  static const bool enabled = [] {
+    const char* home = std::getenv("HOME");
+    if (!home || !*home) {
+      return false;
+    }
+    std::error_code ec;
+    return std::filesystem::exists(
+        std::filesystem::path(home) / "Documents" / "keep_pass_open.txt", ec);
+  }();
+  return enabled;
+}
+
+// Layouts que solo puede tener un adjunto del pase. Una barrera que toque uno
+// de estos en cualquiera de sus dos lados obliga a cerrar el pase.
+bool IsAttachmentLayout(VkImageLayout layout) {
+  switch (layout) {
+    case VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL:
+    case VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL:
+    case VK_IMAGE_LAYOUT_DEPTH_ATTACHMENT_OPTIMAL:
+    case VK_IMAGE_LAYOUT_STENCIL_ATTACHMENT_OPTIMAL:
+    case VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL:
+    case VK_IMAGE_LAYOUT_DEPTH_READ_ONLY_OPTIMAL:
+    case VK_IMAGE_LAYOUT_STENCIL_READ_ONLY_OPTIMAL:
+      return true;
+    default:
+      return false;
+  }
+}
 }  // namespace
 
 
