+// NS3FB diagnostic build: instead of aborting on an unregistered guest
+// function, log the address once and return as a no-op stub so the title keeps
+// running and a single run collects every missing entrypoint in one log.
+// Guest state is not emulated here, so the process may die later in a different
+// way - that is expected and acceptable for address harvesting.
 static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
-  REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X}",
-            ctx.last_indirect_target);
+  static std::mutex trap_mutex;
+  static std::unordered_map<uint32_t, uint64_t> trap_calls;
+  const uint32_t trap_target = ctx.last_indirect_target;
+  uint64_t trap_count = 0;
+  {
+    std::lock_guard<std::mutex> trap_lock(trap_mutex);
+    trap_count = ++trap_calls[trap_target];
+  }
+  // La primera llamada identifica la direccion; despues, una de cada 600 deja
+  // su marca de tiempo en el log: eso es lo que separa un callback de un solo
+  // uso de una ruta caliente que se ejecuta en cada frame.
+  if (trap_count == 1 || (trap_count % 600) == 0) {
+    REXLOG_WARN("NS3FB-TRAP 0x{:08X} unregistered guest function, no-op (calls={})",
+                trap_target, trap_count);
+  }
 }
 
