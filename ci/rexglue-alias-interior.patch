+static bool Ns3fbAliasDisabled() {
+  static const bool disabled = [] {
+    const char* home = std::getenv("HOME");
+    if (!home || !*home) {
+      return false;
+    }
+    std::ifstream marker(std::string(home) + "/Documents/alias_off.txt");
+    return marker.good();
+  }();
+  return disabled;
+}
+
+static uint32_t Ns3fbRedirectInterior(uint32_t guest_address) {
+  constexpr size_t kCount = sizeof(kNs3fbInteriorAlias) / sizeof(kNs3fbInteriorAlias[0]);
+  static bool reported[kCount] = {};
+  for (size_t i = 0; i < kCount; ++i) {
+    if (kNs3fbInteriorAlias[i][0] != guest_address) {
+      continue;
+    }
+    if (Ns3fbAliasDisabled()) {
+      return guest_address;
+    }
+    if (!reported[i]) {
+      reported[i] = true;
+      REXLOG_WARN(
+          "NS3FB-ALIAS 0x{:08X} -> 0x{:08X} (entrada interior: se ejecuta la funcion completa)",
+          guest_address, kNs3fbInteriorAlias[i][1]);
+    }
+    return kNs3fbInteriorAlias[i][1];
+  }
+  return guest_address;
+}
+
 PPCFunc* ResolveIndirectFunction(uint32_t guest_address) {
   FunctionDispatcher* dispatcher = GetBoundFunctionDispatcher();
   if (!dispatcher) {
     return &InvalidFunctionTrap;
   }
 
+  guest_address = Ns3fbRedirectInterior(guest_address);
+
   if (PPCFunc* func = dispatcher->GetFunction(guest_address)) {
     return func;
   }
