+// ---------------------------------------------------------------------------
+// NS3FB: entradas INTERIORES del invitado.
+//
+// El juego llama por puntero a direcciones que caen DENTRO de una funcion, no en
+// su inicio: son colas compartidas (logica final + epilogo). Si el codegen
+// compila el cuerpo DESDE ahi, ese cuerpo desapila un frame que nunca apilo y
+// vuelve con la direccion de retorno de otra pila. No revienta: devuelve un
+// valor arbitrario y deja el estado mal.
+//
+// Sintoma tipico: el juego va bien, el personaje se anima, la musica sigue, y una
+// accion concreta no hace nada porque su comprobacion devuelve 0.
+//
+// Aqui se resuelve SOLO en runtime, a proposito:
+//
+//   - No se siembran direcciones nuevas. Sembrar una direccion que no es inicio
+//     de funcion REAL parte en dos la funcion que la contiene, y entonces los
+//     saltos internos de esa funcion dejan de resolver: el juego muere con
+//     "Unresolved branch". Ya paso con 0x825EB770 (ver docs/INTERIOR_ENTRIES.md).
+//   - No hay tabla curada de direcciones -> funcion: para calcularla hacia falta
+//     saber donde acaba cada funcion, y el "primer blr" NO sirve, porque MSVC
+//     fusiona epilogos y un blr puede aparecer en medio. 16 de 42 entradas
+//     salieron mal por eso.
+//
+// Detectar en el momento de la llamada no inventa fronteras y no puede romper el
+// arranque: si no encuentra nada, se comporta como antes (no-op).
+//
+// A/B sin recompilar: Documents/alias_off.txt lo desactiva.
+// ---------------------------------------------------------------------------
+static bool Ns3fbAliasDisabled() {
+  static const bool disabled = [] {
+    const char* home = std::getenv("HOME");
+    if (!home || !*home) {
+      return false;
+    }
+    std::ifstream marker(std::string(home) + "/Documents/alias_off.txt");
+    return marker.good();
+  }();
+  return disabled;
+}
+
+// Devuelve el inicio de la funcion que contiene 'addr', o 0 si no lo encuentra.
+// Se busca hacia atras el patron de prologo de MSVC y se exige que la
+// instruccion anterior sea un terminador (fin de la funcion previa), que es lo
+// que distingue un inicio de funcion de una direccion intermedia cualquiera.
+static uint32_t Ns3fbFindContainingFunction(const uint8_t* base, uint32_t addr) {
+  if (!base || addr < 0x1000) {
+    return 0;
+  }
+  auto load = [base](uint32_t a) {
+    const uint8_t* p = base + a;
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+  };
+  for (uint32_t back = 4; back <= 0x1400; back += 4) {
+    const uint32_t candidate = addr - back;
+    const uint32_t w0 = load(candidate);
+    const uint32_t w1 = load(candidate + 4);
+    const bool prologue = (w0 == 0x7D8802A6 && w1 == 0x9181FFF8) ||  // mflr r12 / stw r12,-8(r1)
+                          (w0 & 0xFFFF0000) == 0x94210000 ||          // stwu r1,-N(r1)
+                          w0 == 0x7C0802A6;                           // mflr r0
+    if (!prologue) {
+      continue;
+    }
+    const uint32_t previous = load(candidate - 4);
+    const bool boundary = previous == 0x4E800020 ||                       // blr
+                          previous == 0x4E800420 ||                       // bctr
+                          previous == 0x00000000 || previous == 0x60000000 ||  // relleno / nop
+                          (previous & 0xFC000003) == 0x48000000;          // b
+    if (!boundary) {
+      continue;
+    }
+    // La funcion encontrada tiene que CONTENER la direccion: su primer blr no
+    // puede quedar antes. Sin esto, una direccion que ya era inicio de funcion
+    // se confundiria con una intermedia y se redirigiria a la funcion anterior.
+    for (uint32_t fwd = 0; fwd <= 0x1400; fwd += 4) {
+      if (load(candidate + fwd) == 0x4E800020) {
+        return (candidate + fwd) >= addr ? candidate : 0;
+      }
+    }
+    return 0;
+  }
+  return 0;
+}
