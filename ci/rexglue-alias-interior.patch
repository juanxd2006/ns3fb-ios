+/// Desactivable en el dispositivo: Documents/alias_off.txt vuelve al
+/// comportamiento anterior sin recompilar.
+static bool Ns3fbAliasDisabled() {
+  static const bool disabled = [] {
+    const char* home = std::getenv("HOME");
+    if (!home || !*home) {
+      return false;
+    }
+    std::ifstream marker(std::string(home) + "/Documents/alias_off.txt");
+    return marker.good();
+  }();
+  return disabled;
+}
