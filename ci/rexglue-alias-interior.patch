+// Devuelve el inicio de la funcion que contiene 'addr', o 0 si no lo encuentra.
+// Se busca hacia atras el patron de prologo de MSVC y se exige que la
+// instruccion anterior sea un terminador (fin de la funcion previa), que es lo
+// que distingue un inicio de funcion de una direccion intermedia cualquiera.
+static uint32_t Ns3fbFindContainingFunction(const uint8_t* base, uint32_t addr) {
+  if (!base || addr < 0x1000) {
+    return 0;
+  }
+  auto load = [base](uint32_t a) {
+    const uint8_t* p = base + a;
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+  };
+  for (uint32_t back = 4; back <= 0x1400; back += 4) {
+    const uint32_t candidate = addr - back;
+    const uint32_t w0 = load(candidate);
+    const uint32_t w1 = load(candidate + 4);
+    const bool prologue = (w0 == 0x7D8802A6 && w1 == 0x9181FFF8) ||  // mflr r12 / stw r12,-8(r1)
+                          (w0 & 0xFFFF0000) == 0x94210000 ||          // stwu r1,-N(r1)
+                          w0 == 0x7C0802A6;                           // mflr r0
+    if (!prologue) {
+      continue;
+    }
+    const uint32_t previous = load(candidate - 4);
+    const bool boundary = previous == 0x4E800020 ||                       // blr
+                          previous == 0x4E800420 ||                       // bctr
+                          previous == 0x00000000 || previous == 0x60000000 ||  // relleno / nop
+                          (previous & 0xFC000003) == 0x48000000;          // b
+    if (!boundary) {
+      continue;
+    }
+    // La funcion encontrada tiene que CONTENER la direccion: su primer blr no
+    // puede quedar antes. Sin esto, una direccion que ya era inicio de funcion
+    // se confundiria con una intermedia y se redirigiria a la funcion anterior.
+    for (uint32_t fwd = 0; fwd <= 0x1400; fwd += 4) {
+      if (load(candidate + fwd) == 0x4E800020) {
+        return (candidate + fwd) >= addr ? candidate : 0;
+      }
+    }
+    return 0;
+  }
+  return 0;
+}
