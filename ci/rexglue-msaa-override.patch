 namespace rex::graphics {
 
+// NS3FB: MSAA del host configurable desde ns3fb.toml (msaa_override = 1|2|4) o
+// desde un marcador en Documents/ (msaa1.txt, msaa2.txt, msaa4.txt).
+//
+//   msaa_override = 0  -> lo que pida el juego (comportamiento original)
+//                 = 1  -> 1x: elimina el resolve de 4 muestras y el ancho de
+//                         banda 4x, pero tambien el antialiasing y cualquier
+//                         efecto que dependa de cobertura por muestra
+//                 = 2  -> 2x: mitad de ancho de banda conservando cobertura
+//                 = 4  -> 4x: fuerza el maximo (referencia)
+//
+// Se aplica en la lectura de RB_SURFACE_INFO porque de ella derivan a la vez
+// el render pass del host, la clave de las pipelines y la eleccion del shader
+// de resolve (draw_util::GetResolveInfo tambien lee por aqui), asi que todo el
+// camino queda coherente: no puede quedar un target a 1x con un resolve a 4x.
+//
+// El valor se consulta una sola vez: los cvars quedan fijados antes de que se
+// cree el VkDevice, y consultar el registro en cada draw costaria mas que el
+// propio override.
+inline xenos::MsaaSamples ApplyMsaaOverride(xenos::MsaaSamples guest) {
+  static const int32_t requested = [] {
+    const int32_t value = ::rex::cvar::Query<int32_t>("msaa_override");
+    if (value != 0) {
+      // Una sola linea al arrancar: deja constancia en el log del valor que se
+      // esta aplicando, para poder emparejar el log con la fila de la matriz.
+      REXLOG_INFO("NS3FB: msaa_override={} (el valor del invitado se ignora)", value);
+    }
+    return value;
+  }();
+  switch (requested) {
+    case 1:
+      return xenos::MsaaSamples::k1X;
+    case 2:
+      return xenos::MsaaSamples::k2X;
+    case 4:
+      return xenos::MsaaSamples::k4X;
+    default:
+      return guest;
+  }
+}
+
 struct RegisterInfo {
   enum class Type {
     kDword,
@@ -45,7 +88,11 @@ class RegisterFile {
 
   template <typename T>
   T Get(uint32_t reg) const {
-    return rex::memory::Reinterpret<T>(values[reg]);
+    T value = rex::memory::Reinterpret<T>(values[reg]);
+    if constexpr (std::is_same_v<T, reg::RB_SURFACE_INFO>) {
+      value.msaa_samples = ApplyMsaaOverride(value.msaa_samples);
+    }
+    return value;
   }
   template <typename T>
   T Get(Register reg) const {
