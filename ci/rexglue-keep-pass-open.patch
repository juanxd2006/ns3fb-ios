+namespace {
+// NS3FB experimento: mantener el render pass abierto al enviar barreras.
+// Cada cierre obliga a MoltenVK a terminar y reabrir el encoder de Metal; en
+// Storm 3 se cierra ~57 veces por frame. Se activa creando el archivo
+// Documents/keep_pass_open.txt en el contenedor de la app (app Archivos), asi
+// se puede comparar A/B sin recompilar.
+bool KeepPassOpenEnabled() {
+  static const bool enabled = [] {
+    const char* home = std::getenv("HOME");
+    if (!home || !*home) {
+      return false;
+    }
+    std::error_code ec;
+    return std::filesystem::exists(
+        std::filesystem::path(home) / "Documents" / "keep_pass_open.txt", ec);
+  }();
+  return enabled;
+}
