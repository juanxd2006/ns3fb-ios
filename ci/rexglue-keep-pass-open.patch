+namespace {
+// NS3FB experimento A (conservador): mantener el render pass abierto cuando se
+// envian barreras, pero SOLO si ninguna de las barreras pendientes es de
+// imagen. Las barreras de imagen pueden transicionar los adjuntos del pase, y
+// hacerlo dentro del pase es ilegal en Vulkan (la version sin filtrar daba
+// pantalla negra). Las de buffer si son legales dentro de un render pass.
+// Se activa creando Documents/keep_pass_open.txt en la app Archivos.
+bool KeepPassOpenEnabled() {
+  static const bool enabled = [] {
+    const char* home = std::getenv("HOME");
+    if (!home || !*home) {
+      return false;
+    }
+    std::error_code ec;
+    return std::filesystem::exists(
+        std::filesystem::path(home) / "Documents" / "keep_pass_open.txt", ec);
+  }();
+  return enabled;
+}
+std::atomic<uint64_t> g_pass_kept_open{0};
+}  // namespace
