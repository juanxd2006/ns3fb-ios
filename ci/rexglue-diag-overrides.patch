+// NS3FB: overrides de diagnostico del 3D negro.
+//
+//   ztest_off  fuerza z_enable = 0 en RB_DEPTHCONTROL. Si con esto aparece la
+//              geometria que salia negra, el problema era el depth test (el
+//              buffer de profundidad tenia un contenido inesperado), no el
+//              shader ni el blending.
+//   blend_off  fuerza One/Zero/Add, que es exactamente la condicion con la que
+//              pipeline_cache.cpp pone blendEnable = VK_FALSE. Si con esto
+//              aparece, el culpable es el blending: el alpha que escribe el
+//              shader se estaba mezclando contra un destino negro.
+//
+// Se aplican en la LECTURA de los registros, no en el pipeline, porque de esa
+// lectura derivan a la vez el estado del draw, la clave de las pipelines y la
+// creacion del pipeline: asi no puede quedar un estado incoherente entre capas.
+// El valor se consulta una sola vez (los cvars quedan fijados antes de crear el
+// VkDevice) para no pagar un lookup por draw.
+inline reg::RB_DEPTHCONTROL ApplyZTestOverride(reg::RB_DEPTHCONTROL depth_control) {
+  static const bool forced_off = [] {
+    const bool value = ::rex::cvar::Query<bool>("ztest_off");
+    if (value) {
+      REXLOG_INFO("NS3FB: ztest_off=1 (z test forzado a OFF en todos los draws)");
+    }
+    return value;
+  }();
+  if (forced_off) {
+    depth_control.z_enable = 0;
+  }
+  return depth_control;
+}
+
+inline reg::RB_BLENDCONTROL ApplyBlendOverride(reg::RB_BLENDCONTROL blend_control) {
+  static const bool forced_off = [] {
+    const bool value = ::rex::cvar::Query<bool>("blend_off");
+    if (value) {
+      REXLOG_INFO("NS3FB: blend_off=1 (blending forzado a OFF en todos los draws)");
+    }
+    return value;
+  }();
+  if (forced_off) {
+    blend_control.color_srcblend = xenos::BlendFactor::kOne;
+    blend_control.color_comb_fcn = xenos::BlendOp::kAdd;
+    blend_control.color_destblend = xenos::BlendFactor::kZero;
+    blend_control.alpha_srcblend = xenos::BlendFactor::kOne;
+    blend_control.alpha_comb_fcn = xenos::BlendOp::kAdd;
+    blend_control.alpha_destblend = xenos::BlendFactor::kZero;
+  }
+  return blend_control;
+}
+
